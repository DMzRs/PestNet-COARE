# Copy to coare/coare.env, then replace every REPLACE_* value.
# Bash syntax. Use absolute Linux paths. Source this only for your own configuration.
CONDA_MODULE="REPLACE_WITH_MODULE_NAME_FROM_MODULE_AVAIL"
# If Conda is already on PATH without loading a module, use CONDA_MODULE="".
ENV_PREFIX="/REPLACE_WITH_ASSIGNED_SCRATCH3_PATH/envs/pestnet-github"
DATA_YAML="/REPLACE_WITH_DATASET_PATH/IP102/data_coare.yaml"
# Use the exact partition and QOS assigned to your account.
SETUP_PARTITION="REPLACE_WITH_SETUP_PARTITION"
SETUP_QOS="REPLACE_WITH_SETUP_QOS"
GPU_PARTITION="REPLACE_WITH_GPU_PARTITION"
GPU_QOS="REPLACE_WITH_GPU_QOS"
SLURM_ACCOUNT=""  # Fill if COARE requires an explicit account.
GPU_GRES="gpu:1" # Replace if COARE requires a typed GRES.
SETUP_TIME="00:30:00"
SMOKE_TIME="00:30:00"
TRAIN_TIME="24:00:00" # A proposed request; must fit your assigned QOS wall-time limit.
SETUP_CPUS=2
SETUP_MEMORY="8G"
GPU_CPUS=8
GPU_MEMORY="32G" # Host RAM, separate from GPU VRAM; adjust from smoke-job measurements.
# Proposed compatible environment, not recovered author environment:
TORCH_INDEX_URL="https://download.pytorch.org/whl/cu118"
# Native framework network setting; true may cause the native AMP check to be skipped.
# Some native font/asset download paths can still attempt network access.
YOLO_OFFLINE="false"
